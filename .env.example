# ─── Model paths ──────────────────────────────────────────────────────────────
MODEL_PATH=./outputs/mistral-medical-merged
INFERENCE_ENGINE=hf                        # hf | vllm

# ─── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx   # huggingface.co/settings/tokens
HF_REPO_ID=your-username/mistral-7b-medical-qlora

# ─── Weights & Biases ─────────────────────────────────────────────────────────
WANDB_API_KEY=your_wandb_key_here          # wandb.ai/authorize
WANDB_PROJECT=mistral-qlora-medical

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_RPM=30                          # requests per minute per IP

# ─── SaaS: License Keys ──────────────────────────────────────────────────────
# JSON format: {"KEY1": {"tier": "starter", "email": "a@b.com"}, ...}
# CSV format:  KEY1,KEY2,KEY3  (all default to starter tier)
VALID_KEYS=MSAI-TEST-KEY1-DEMO

# ─── SaaS: Lemon Squeezy ─────────────────────────────────────────────────────
LEMONSQUEEZY_WEBHOOK_SECRET=your_ls_webhook_signing_secret
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx     # resend.com API key
RESEND_FROM_EMAIL=noreply@medscribe.ai

# ─── SaaS: Admin ─────────────────────────────────────────────────────────────
ADMIN_SECRET=change_this_to_a_random_secret
USAGE_DB_PATH=medscribe_usage.db

# ─── Frontend ─────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
